rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo voi due potete leggere e scrivere. Sostituite le due email con quelle create in Authentication.
    function siamoNoi() {
      return request.auth != null
        && request.auth.token.email in ['EMAIL_1', 'EMAIL_2'];
    }
    match /{document=**} {
      allow read, write: if siamoNoi();
    }
  }
}
